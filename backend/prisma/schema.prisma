generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String               @id @default(uuid()) @db.Uuid
  username     String               @unique @db.VarChar(100)
  email        String               @unique @db.VarChar(255)
  passwordHash String               @map("password_hash") @db.VarChar(255)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")
  deletedBy    String?              @map("deleted_by") @db.Uuid
  categories   CredentialCategory[]
  groups       CredentialGroup[]
  credentials  Credential[]

  @@map("users")
}

model CredentialGroup {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  parentId    String?           @map("parent_id") @db.Uuid
  name        String            @db.VarChar(150)
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")
  createdBy   String?           @map("created_by") @db.Uuid
  updatedAt   DateTime          @updatedAt @map("updated_at")
  updatedBy   String?           @map("updated_by") @db.Uuid
  deletedAt   DateTime?         @map("deleted_at")
  deletedBy   String?           @map("deleted_by") @db.Uuid
  parent      CredentialGroup?  @relation("GroupHierarchy", fields: [parentId], references: [id])
  children    CredentialGroup[] @relation("GroupHierarchy")
  user        User              @relation(fields: [userId], references: [id])
  credentials Credential[]

  @@index([userId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("credential_groups")
}

model CredentialCategory {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  name        String       @db.VarChar(150)
  description String?
  createdAt   DateTime     @default(now()) @map("created_at")
  createdBy   String?      @map("created_by") @db.Uuid
  updatedAt   DateTime     @updatedAt @map("updated_at")
  updatedBy   String?      @map("updated_by") @db.Uuid
  deletedAt   DateTime?    @map("deleted_at")
  deletedBy   String?      @map("deleted_by") @db.Uuid
  user        User         @relation(fields: [userId], references: [id])
  credentials Credential[]

  @@index([userId])
  @@index([deletedAt])
  @@map("credential_categories")
}

model Credential {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  groupId        String             @map("group_id") @db.Uuid
  categoryId     String             @map("category_id") @db.Uuid
  name           String             @db.VarChar(150)
  username       String             @db.VarChar(255)
  encryptedValue String             @map("encrypted_value")
  url            String?
  notes          String?
  createdAt      DateTime           @default(now()) @map("created_at")
  createdBy      String?            @map("created_by") @db.Uuid
  updatedAt      DateTime           @updatedAt @map("updated_at")
  updatedBy      String?            @map("updated_by") @db.Uuid
  deletedAt      DateTime?          @map("deleted_at")
  deletedBy      String?            @map("deleted_by") @db.Uuid
  category       CredentialCategory @relation(fields: [categoryId], references: [id])
  group          CredentialGroup    @relation(fields: [groupId], references: [id])
  user           User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([groupId])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("credentials")
}
